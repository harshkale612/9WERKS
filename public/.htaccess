# =============================================================================
# 9WERKS — Apache / LiteSpeed configuration (Hostinger shared hosting)
# The site is a static export: every route is /path/index.html.
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html

# --- Canonical host: HTTPS + www --------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301,NE]

  # --- Legacy URLs from the previous site (301, query strings preserved) -----
  # e.g. /booking.html?service=brakes → /booking/?service=brakes
  RewriteRule ^index\.html$   /           [L,R=301]
  RewriteRule ^about\.html$   /about/     [L,R=301]
  RewriteRule ^service\.html$ /services/  [L,R=301]
  RewriteRule ^contact\.html$ /contact/   [L,R=301]
  RewriteRule ^booking\.html$ /booking/   [L,R=301]
  # (Fragments such as service.html#brakes are kept by the browser and match
  #  the anchors on /services/.)

  # --- Trailing slash for directory routes -----------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# --- Not found ---------------------------------------------------------------
ErrorDocument 404 /404.html

# --- MIME types ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType model/gltf-binary .glb
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

# --- Compression (text, JS, CSS, SVG, JSON, wasm, 3D model) ------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json application/wasm model/gltf-binary
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json application/wasm model/gltf-binary
</IfModule>

# --- Caching ------------------------------------------------------------------
<IfModule mod_headers.c>
  # Fingerprinted build output: cache forever.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images, video, fonts, 3D model, decoder: 30 days.
  <FilesMatch "\.(avif|webp|png|jpg|jpeg|ico|svg|mp4|webm|glb|wasm|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML always revalidates so new deployments show immediately.
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # --- Security headers -------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
